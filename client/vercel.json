{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://plugins-water-despite-dans.trycloudflare.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://plugins-water-despite-dans.trycloudflare.com/uploads/:path*"
    },
    {
      "source": "/((?!api|uploads|assets|kanban-bg.png|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}

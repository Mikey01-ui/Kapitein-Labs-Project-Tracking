# Copy to .env for local Docker, or set these in the Vercel project.

# --- Production (Vercel + Supabase) ---
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=https://www.proj.kapiteinlabs.com,https://proj.kapiteinlabs.com

# Supabase Postgres — pooled URI (port 6543) with pgbouncer=true
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase Postgres — direct URI (port 5432) for migrations
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=uploads

# First admin (used only by `npm run db:seed`)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Optional integrations
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
NOVU_SECRET_KEY=
ANTHROPIC_API_KEY=

# --- Local Docker only (ignore these on Vercel) ---
WEB_PORT=8080
POSTGRES_USER=kapitein
POSTGRES_PASSWORD=change-me
POSTGRES_DB=project_tracking
RUN_SEED=true

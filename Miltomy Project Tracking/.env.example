# Copy this file to .env and fill in production values.
# docker compose up --build reads these automatically.

WEB_PORT=8080

# --- Postgres ---
POSTGRES_USER=kapitein
POSTGRES_PASSWORD=change-me
POSTGRES_DB=project_tracking

# --- API ---
NODE_ENV=production
PORT=4000
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:8080

# First admin created when RUN_SEED=true (change immediately after login)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
RUN_SEED=true

# --- Optional integrations ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
NOVU_SECRET_KEY=
ANTHROPIC_API_KEY=
